{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/resilience/.*\\.spec\\.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "testEnvironment": "node",
  
  "setupFilesAfterEnv": ["<rootDir>/test/integration/setup.ts"],
  "testTimeout": 180000,
  "maxWorkers": 1,
  "moduleNameMapper": { "^@/(.*)$": "<rootDir>/src/$1" }
}
