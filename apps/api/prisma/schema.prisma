// ═══════════════════════════════════════════════════════════════
//  Patron Platform — Database Schema  (v1.0 FINAL)
//  PostgreSQL 15+ / Prisma 6
//  Conventions:
//    - UUID primary keys
//    - Money = Decimal(14,4); minor-unit safe, no floats
//    - Soft delete via deletedAt on customer-visible entities
//    - *Enc suffix = encrypted at rest (AES-256-GCM, app layer)
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════ ENUMS ═══════════════

enum ProductType {
  GAME_TOPUP
  GIFT_CARD
  SUBSCRIPTION
  LICENSE
}

enum DeliveryMode {
  AUTO_PROVIDER // fulfilled live via external provider API
  CODE_POOL // pulled from pre-purchased code inventory
  MANUAL // admin fulfils by hand
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentGateway {
  WALLET
  MOYASAR
  TAP
  STRIPE
  MANUAL
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum WalletTxnType {
  TOPUP
  ORDER_PAYMENT
  REFUND
  ADMIN_ADJUSTMENT
  CASHBACK
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PHONE_VERIFY
  PASSWORD_RESET
  TWO_FACTOR
  PHONE_LOGIN
  /// A reset the owner opened after checking who the customer is (support-assisted recovery).
  ACCOUNT_RECOVERY
}

enum QuoteStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
  DEAD
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  FAILED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// ═══════════════ USERS & ACCESS CONTROL ═══════════════

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String?   @unique // null for accounts made with a WhatsApp number only
  phone           String?   @unique // E.164, e.g. +22222123456
  passwordHash    String? // null for WhatsApp-number accounts (they sign in by code)
  fullName        String
  avatarUrl       String?
  locale          String    @default("ar")
  isActive        Boolean   @default(true)
  isBlocked       Boolean   @default(false)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  twoFaSecretEnc  String?
  twoFaEnabled    Boolean   @default(false)
  defaultCurrency String    @default("USD") @db.Char(3)
  lastLoginAt     DateTime?
  lastLoginIp     String?
  /// Where the customer lives (ISO country, city they typed): the owner sees where customers are.
  country         String?   @db.Char(2)
  city            String?
  /// Only staff see these.
  adminNote       String?
  tags            String[]  @default([])

  roles              UserRole[]
  orders             Order[]
  quotes             CheckoutQuote[]
  payments           Payment[]
  wallets            Wallet[]
  walletTransactions WalletTransaction[]
  notifications      Notification[]
  devices            DeviceToken[]
  refreshTokens      RefreshToken[]
  verifications      VerificationToken[]
  auditLogs          AuditLog[]
  refundsRequested   Refund[]                 @relation("RefundRequester")
  refundsProcessed   Refund[]                 @relation("RefundProcessor")
  savedInputs        SavedInput[]
  favorites          Favorite[]
  priceWatches       PriceWatch[]
  reviews            Review[]
  passkeys           Passkey[]
  recoveryRequests   AccountRecoveryRequest[] @relation("RecoveryRequester")
  recoveryReviews    AccountRecoveryRequest[] @relation("RecoveryReviewer")
  usdtOrders         UsdtOrder[]              @relation("UsdtOrderCustomer")
  usdtReviews        UsdtOrder[]              @relation("UsdtOrderReviewer")
  agent              Agent?                   @relation("AgentUser")
  /// The agent (مندوب) whose referral code brought this customer.
  referredByAgentId  String?                  @db.Uuid
  referredByAgent    Agent?                   @relation("AgentReferrals", fields: [referredByAgentId], references: [id], onDelete: SetNull)
  supportTickets     SupportTicket[]
  storeEvents        StoreEvent[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@index([createdAt])
  @@index([country])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique // super_admin, admin, support, finance, customer
  description String?
  isSystem    Boolean @default(false) // system roles cannot be deleted

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique // "orders.refund", "products.create"
  module      String // orders, products, providers, reports ...
  description String?

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Refresh-token rotation; one row per active session
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique // SHA-256 of the token, never the raw value
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid
  /// One id per signed-in device, kept across rotations, so a session can be listed and signed out.
  sessionId  String?   @db.Uuid
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// OTP / one-time links for verification, 2FA and password reset
model VerificationToken {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    VerificationPurpose
  codeHash   String
  // set only for codes the owner relays over WhatsApp: they must be able to read it
  codeEnc    String?
  sentAt     DateTime?
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                 @default(0)

  createdAt DateTime @default(now())

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String // email or phone entered
  ipAddress  String
  success    Boolean
  reason     String?
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String         @unique
  platform   DevicePlatform
  isActive   Boolean        @default(true)
  lastSeenAt DateTime       @default(now())

  createdAt DateTime @default(now())

  @@index([userId, isActive])
  @@map("device_tokens")
}

// ═══════════════ CATALOG ═══════════════

model Category {
  id        String  @id @default(uuid()) @db.Uuid
  slug      String  @unique
  nameAr    String
  nameEn    String
  iconUrl   String?
  bannerUrl String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  parentId String?    @db.Uuid
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  games    Game[]
  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

model Game {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  nameAr      String
  nameEn      String
  description String?
  coverUrl    String?
  logoUrl     String?
  publisher   String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  isFeatured  Boolean @default(false)

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Declarative form the customer fills before checkout.
  // [{ key, labelAr, labelEn, type, required, regex, sensitive }]
  inputSchema Json?

  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId, isActive])
  @@index([isFeatured])
  @@map("games")
}

model Product {
  id          String       @id @default(uuid()) @db.Uuid
  sku         String       @unique
  type        ProductType
  delivery    DeliveryMode
  nameAr      String
  nameEn      String
  description String?
  imageUrl    String?

  costPrice       Decimal @db.Decimal(14, 4) // reference cost, actual cost per provider
  sellPrice       Decimal @db.Decimal(14, 4)
  // Owner-set discount, whole percent (0-90, validated in the DTO). null = none.
  // Applied by PricingService to every currency, overrides included.
  discountPercent Int?
  currency        String  @default("SAR") @db.Char(3)

  // null stockQty = unlimited (provider-backed); CODE_POOL derives from code inventory
  stockQty      Int?
  lowStockAlert Int?    @default(5)
  maxPerOrder   Int     @default(10)
  isActive      Boolean @default(true)
  isFeatured    Boolean @default(false)
  sortOrder     Int     @default(0)

  // type-specific extras: { durationDays, region, platform, licenseTerm ... }
  metadata Json?

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  gameId     String?  @db.Uuid
  game       Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)

  prices     ProductPrice[]
  quoteItems QuoteItem[]
  providers  ProductProvider[]
  codes      ProductCode[]
  orderItems OrderItem[]
  watches    PriceWatch[]
  reviews    Review[]

  /// Usual minutes from paid to delivered, shown to customers ("usually within 10 minutes").
  etaMinutes Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId, isActive])
  @@index([gameId, isActive])
  @@index([type, isActive])
  @@index([isFeatured])
  @@map("products")
}

// Pre-purchased inventory for CODE_POOL products
model ProductCode {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  codeEnc   String // AES-256-GCM ciphertext
  codeHash  String?   @unique // SHA-256 of the normalised code: a code is never stocked twice
  serialEnc String?
  batchRef  String?
  expiresAt DateTime?

  isUsed      Boolean    @default(false)
  usedAt      DateTime?
  orderItemId String?    @db.Uuid // an item of quantity n takes n codes
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId, isUsed])
  @@index([expiresAt])
  @@index([orderItemId])
  @@map("product_codes")
}

/// Files people upload, kept in the database: the host keeps no disk across
/// deploys and the owner has no image hosting. Transfer receipts are private
/// (staff only); logos and banner images are public.
model Upload {
  id        String   @id @default(uuid()) @db.Uuid
  kind      String // payment_proof | logo | banner
  mime      String
  size      Int
  data      Bytes
  isPublic  Boolean  @default(false)
  userId    String?  @db.Uuid
  paymentId String?  @db.Uuid
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@map("uploads")
}

model Banner {
  id         String    @id @default(uuid()) @db.Uuid
  titleAr    String
  titleEn    String?
  subtitleAr String?
  imageUrl   String?
  tone       String    @default("teal") // teal | gold | ink | rose (text-only banners)
  linkType   String? // product | offers | url
  linkValue  String?
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("banners")
}

// ═══════════════ PROVIDERS ═══════════════

model Provider {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique // fazercards, foxreload
  name    String
  baseUrl String

  apiKeyEnc    String // encrypted
  apiSecretEnc String?
  extraConfig  Json? // per-provider knobs (currency, callback url, ...)

  isActive        Boolean  @default(true)
  priority        Int      @default(0) // lower = tried first
  balance         Decimal  @default(0) @db.Decimal(14, 4)
  lowBalanceAlert Decimal? @db.Decimal(14, 4)
  timeoutMs       Int      @default(20000)
  maxRetries      Int      @default(2)

  lastHealthCheckAt DateTime?
  isHealthy         Boolean   @default(true)

  products ProductProvider[]
  calls    ProviderCall[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, priority])
  @@map("providers")
}

// Mapping table: which provider can fulfil which product, at what cost
model ProductProvider {
  id           String  @id @default(uuid()) @db.Uuid
  productId    String  @db.Uuid
  providerId   String  @db.Uuid
  providerSku  String // the provider's own product identifier
  providerCost Decimal @db.Decimal(14, 4)
  priority     Int     @default(0) // failover order within the product
  isActive     Boolean @default(true)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, providerId])
  @@unique([providerId, providerSku])
  @@index([productId, priority])
  @@map("product_providers")
}

// Full audit of every outbound provider request — billing disputes depend on this
model ProviderCall {
  id         String   @id @default(uuid()) @db.Uuid
  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  orderItemId String?    @db.Uuid
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  endpoint       String
  httpMethod     String  @default("POST")
  idempotencyKey String? @unique
  requestBody    Json // secrets redacted before persisting
  responseBody   Json?
  httpStatus     Int?
  success        Boolean @default(false)
  errorCode      String?
  errorMessage   String?
  attemptNo      Int     @default(1)
  durationMs     Int?

  createdAt DateTime @default(now())

  @@index([orderItemId])
  @@index([providerId, createdAt])
  @@index([success, createdAt])
  @@map("provider_calls")
}

// ═══════════════ ORDERS ═══════════════

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  orderNumber String      @unique // PTN-20260720-000123
  userId      String      @db.Uuid
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status      OrderStatus @default(PENDING_PAYMENT)

  subtotal     Decimal  @db.Decimal(14, 4)
  discount     Decimal  @default(0) @db.Decimal(14, 4)
  fees         Decimal  @default(0) @db.Decimal(14, 4)
  // MVP: always 0. Wiring VAT on later is a config change, not a migration.
  taxAmount    Decimal  @default(0) @db.Decimal(14, 4)
  taxRate      Decimal? @db.Decimal(6, 4)
  taxInclusive Boolean  @default(false)
  total        Decimal  @db.Decimal(14, 4)

  // Currency the customer transacted in, plus the rate snapshot used to
  // express this order in the platform base currency for reporting.
  currency     String  @db.Char(3)
  baseCurrency String  @db.Char(3)
  fxRate       Decimal @db.Decimal(20, 10)
  totalBase    Decimal @db.Decimal(14, 4)
  fxRateId     String? @db.Uuid
  fxRateUsed   FxRate? @relation(fields: [fxRateId], references: [id], onDelete: SetNull)

  couponId String? @db.Uuid
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  quoteId        String?        @unique @db.Uuid
  quote          CheckoutQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  // Incremented on every write; concurrent updates lose and retry.
  version        Int            @default(0)
  idempotencyKey String?        @unique // guards double-submit from mobile clients
  ipAddress      String?
  userAgent      String?
  notes          String?

  items    OrderItem[]
  payments Payment[]
  refunds  Refund[]
  tickets  SupportTicket[]

  /// Staff-only note on the order.
  adminNote String?

  /// The agent credited for this order (the customer's referrer when it was placed).
  agentId    String?     @db.Uuid
  agent      Agent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  commission Commission?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  completedAt DateTime?

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // price/name snapshot — catalog changes must never rewrite history
  productNameAr String
  productNameEn String
  quantity      Int             @default(1)
  unitPrice     Decimal         @db.Decimal(14, 4)
  unitCost      Decimal         @db.Decimal(14, 4)
  lineTotal     Decimal         @db.Decimal(14, 4)
  taxAmount     Decimal         @default(0) @db.Decimal(14, 4)
  taxRate       Decimal?        @db.Decimal(6, 4)
  status        OrderItemStatus @default(PENDING)

  // Provider chosen when the quote was priced. The engine may fail over to a
  // different one, but the cost we committed to is the frozen unitCost.
  plannedProviderId     String? @db.Uuid
  fulfilledByProviderId String? @db.Uuid
  attemptCount          Int     @default(0)
  lastError             String?
  version               Int     @default(0)

  inputs        OrderInput[]
  results       OrderResult[]
  providerCalls ProviderCall[]
  assignedCodes ProductCode[]

  review Review?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deliveredAt DateTime?

  @@index([orderId])
  @@index([status])
  @@index([productId])
  @@map("order_items")
}

// What the customer typed at checkout (Player ID, server, email ...)
model OrderInput {
  id          String    @id @default(uuid()) @db.Uuid
  orderItemId String    @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  fieldKey    String
  fieldLabel  String
  value       String // encrypted when isSensitive
  isSensitive Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([orderItemId, fieldKey])
  @@map("order_inputs")
}

// What was actually delivered (code, serial, receipt, provider message)
model OrderResult {
  id          String    @id @default(uuid()) @db.Uuid
  orderItemId String    @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  resultType  String // code | serial | receipt | message
  valueEnc    String // AES-256-GCM ciphertext
  providerRef String?
  viewedAt    DateTime? // first time the customer revealed it
  deliveredAt DateTime  @default(now())

  @@index([orderItemId])
  @@map("order_results")
}

// ═══════════════ PAYMENTS ═══════════════

model Payment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  userId  String @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  gateway        PaymentGateway
  gatewayRef     String?        @unique
  amount         Decimal        @db.Decimal(14, 4)
  currency       String         @db.Char(3)
  baseCurrency   String         @db.Char(3)
  fxRate         Decimal        @db.Decimal(20, 10)
  amountBase     Decimal        @db.Decimal(14, 4)
  fxRateId       String?        @db.Uuid
  fxRateUsed     FxRate?        @relation(fields: [fxRateId], references: [id], onDelete: SetNull)
  status         PaymentStatus  @default(INITIATED)
  refundedAmount Decimal        @default(0) @db.Decimal(14, 4)

  version   Int     @default(0)
  cardBrand String?
  cardLast4 String? @db.VarChar(4)

  rawResponse   Json? // PAN/CVV never stored
  failureCode   String?
  failureReason String?

  refunds Refund[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  capturedAt DateTime?

  @@index([orderId])
  @@index([userId, status])
  @@index([status, createdAt])
  @@map("payments")
}

model Refund {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId String?  @db.Uuid
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  amount     Decimal      @db.Decimal(14, 4)
  currency   String       @db.Char(3)
  fxRate     Decimal      @db.Decimal(20, 10)
  amountBase Decimal      @db.Decimal(14, 4)
  reason     String
  status     RefundStatus @default(REQUESTED)
  gatewayRef String?
  toWallet   Boolean      @default(false)

  requestedById String  @db.Uuid
  requestedBy   User    @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  processedById String? @db.Uuid
  processedBy   User?   @relation("RefundProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  @@index([orderId])
  @@index([status, createdAt])
  @@map("refunds")
}

model WalletTransaction {
  id       String        @id @default(uuid()) @db.Uuid
  walletId String        @db.Uuid
  wallet   Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId   String        @db.Uuid
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     WalletTxnType

  amount        Decimal @db.Decimal(14, 4) // signed: credit +, debit −
  balanceBefore Decimal @db.Decimal(14, 4)
  balanceAfter  Decimal @db.Decimal(14, 4)
  currency      String  @db.Char(3)

  referenceType String? // order | payment | refund | manual
  referenceId   String? @db.Uuid
  description   String?
  createdById   String? @db.Uuid // admin who made the adjustment

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

model Coupon {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(14, 4)
  maxDiscount   Decimal?     @db.Decimal(14, 4) // caps a PERCENT coupon
  minOrderTotal Decimal?     @db.Decimal(14, 4)
  // FIXED coupons and thresholds are denominated in this currency and
  // converted at redemption. null = platform base currency.
  currency      String?      @db.Char(3)

  maxUses        Int?
  maxUsesPerUser Int?      @default(1)
  usedCount      Int       @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)

  orders Order[]
  quotes CheckoutQuote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, expiresAt])
  @@map("coupons")
}

// ═══════════════ SYSTEM ═══════════════

model Notification {
  id      String              @id @default(uuid()) @db.Uuid
  userId  String              @db.Uuid
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel NotificationChannel @default(IN_APP)

  titleAr String
  titleEn String
  bodyAr  String
  bodyEn  String
  data    Json? // deep-link payload: { type, orderId ... }

  isRead Boolean   @default(false)
  readAt DateTime?
  sentAt DateTime?
  error  String?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String // order.refund, product.update, provider.key_rotate
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Pre-aggregated daily figures. The raw tables remain the source of truth;
/// this is a cache that can be rebuilt from them at any time.
model DailyRollup {
  day            DateTime @db.Date
  currency       String   @db.Char(3)
  orders         Int      @default(0)
  paidOrders     Int      @default(0)
  failedOrders   Int      @default(0)
  itemsDelivered Int      @default(0)
  itemsFailed    Int      @default(0)
  grossBase      Decimal  @default(0) @db.Decimal(18, 4)
  discountBase   Decimal  @default(0) @db.Decimal(18, 4)
  refundBase     Decimal  @default(0) @db.Decimal(18, 4)
  costBase       Decimal  @default(0) @db.Decimal(18, 4)
  newCustomers   Int      @default(0)
  computedAt     DateTime @default(now())

  @@id([day, currency])
  @@index([day])
  @@map("daily_rollups")
}

model SystemSetting {
  key         String  @id
  value       Json
  group       String  @default("general")
  description String?
  isPublic    Boolean @default(false) // exposed to the customer apps

  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("system_settings")
}

// ═══════════════ CURRENCY & FX ═══════════════

model Currency {
  code      String  @id @db.Char(3) // USD, EUR, MRU, XOF
  nameAr    String
  nameEn    String
  symbol    String
  decimals  Int     @default(2) // XOF = 0, MRU = 2, USD/EUR = 2
  isBase    Boolean @default(false) // exactly one row may be true
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  // rounding applied after conversion: HALF_UP | UP | DOWN
  roundingMode String   @default("HALF_UP")
  // optional psychological rounding, e.g. 100 => nearest 100 XOF
  roundingStep Decimal? @db.Decimal(14, 4)

  ratesFrom     FxRate[]       @relation("FxBase")
  ratesTo       FxRate[]       @relation("FxQuote")
  productPrices ProductPrice[]
  wallets       Wallet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("currencies")
}

// Immutable, append-only rate history. Never updated in place — a new rate
// supersedes the previous one, so every historic order can be re-derived.
model FxRate {
  id            String  @id @default(uuid()) @db.Uuid
  baseCurrency  String  @db.Char(3)
  quoteCurrency String  @db.Char(3)
  rate          Decimal @db.Decimal(20, 10) // 1 base = <rate> quote

  source      String    @default("MANUAL") // MANUAL | ECB | OPENEXCHANGE ...
  effectiveAt DateTime  @default(now())
  expiresAt   DateTime?
  isActive    Boolean   @default(true)

  base  Currency @relation("FxBase", fields: [baseCurrency], references: [code], onDelete: Restrict)
  quote Currency @relation("FxQuote", fields: [quoteCurrency], references: [code], onDelete: Restrict)

  orders   Order[]
  payments Payment[]
  quotes   CheckoutQuote[]

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@unique([baseCurrency, quoteCurrency, effectiveAt])
  @@index([baseCurrency, quoteCurrency, isActive, effectiveAt])
  @@map("fx_rates")
}

// Optional manual price override per currency. When absent, the product's
// base-currency sellPrice is converted with the live FxRate.
model ProductPrice {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @db.Uuid
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  currencyCode String   @db.Char(3)
  currency     Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  sellPrice Decimal @db.Decimal(14, 4)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, currencyCode])
  @@index([currencyCode])
  @@map("product_prices")
}

// One balance per user per currency. Balances are never converted between
// wallets implicitly — a top-up in EUR stays in EUR.
model Wallet {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currencyCode String   @db.Char(3)
  currency     Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  balance  Decimal @default(0) @db.Decimal(14, 4)
  version  Int     @default(0)
  isActive Boolean @default(true)

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, currencyCode])
  @@index([userId])
  @@map("wallets")
}

// ═══════════════ CHECKOUT QUOTES ═══════════════

/// A priced, time-boxed offer. Everything that can move between browsing and
/// paying — sell price, provider cost, FX rate, tax — is frozen here, so the
/// customer pays exactly what they were shown and margin is known up front.
model CheckoutQuote {
  id          String      @id @default(uuid()) @db.Uuid
  quoteNumber String      @unique
  userId      String      @db.Uuid
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      QuoteStatus @default(ACTIVE)

  // ── frozen money ──
  subtotal     Decimal  @db.Decimal(14, 4)
  discount     Decimal  @default(0) @db.Decimal(14, 4)
  fees         Decimal  @default(0) @db.Decimal(14, 4)
  taxAmount    Decimal  @default(0) @db.Decimal(14, 4)
  taxRate      Decimal? @db.Decimal(6, 4)
  taxInclusive Boolean  @default(false)
  total        Decimal  @db.Decimal(14, 4)

  // ── frozen FX ──
  currency     String  @db.Char(3)
  baseCurrency String  @db.Char(3)
  fxRate       Decimal @db.Decimal(20, 10)
  fxRateId     String? @db.Uuid
  fxRateUsed   FxRate? @relation(fields: [fxRateId], references: [id], onDelete: SetNull)
  totalBase    Decimal @db.Decimal(14, 4)

  // ── frozen cost, for margin at the moment of sale ──
  totalCostBase Decimal @db.Decimal(14, 4)

  couponId String? @db.Uuid
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  expiresAt  DateTime
  consumedAt DateTime?
  ipAddress  String?

  items QuoteItem[]
  order Order?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("checkout_quotes")
}

model QuoteItem {
  id        String        @id @default(uuid()) @db.Uuid
  quoteId   String        @db.Uuid
  quote     CheckoutQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String        @db.Uuid
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  // snapshots — the catalog may change before the quote is consumed
  productNameAr String
  productNameEn String
  quantity      Int     @default(1)
  unitPrice     Decimal @db.Decimal(14, 4) // in quote currency
  unitPriceBase Decimal @db.Decimal(14, 4)
  unitCostBase  Decimal @db.Decimal(14, 4) // provider cost at quote time
  lineTotal     Decimal @db.Decimal(14, 4)
  taxAmount     Decimal @default(0) @db.Decimal(14, 4)

  plannedProviderId String? @db.Uuid

  inputs QuoteItemInput[]

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@map("quote_items")
}

model QuoteItemInput {
  id          String    @id @default(uuid()) @db.Uuid
  quoteItemId String    @db.Uuid
  quoteItem   QuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)

  fieldKey    String
  fieldLabel  String
  value       String
  isSensitive Boolean @default(false)

  @@unique([quoteItemId, fieldKey])
  @@map("quote_item_inputs")
}

// ═══════════════ RELIABILITY PRIMITIVES ═══════════════

/// Transactional outbox. Side effects (queue jobs, notifications) are written
/// in the same transaction as the state change, then published by a relay.
/// Guarantees a committed order can never lose its fulfilment job.
model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  aggregate   String // Order, Payment, Refund ...
  aggregateId String
  eventType   String // order.paid, payment.captured ...
  payload     Json
  status      OutboxStatus @default(PENDING)

  attempts    Int       @default(0)
  lastError   String?
  publishedAt DateTime?
  availableAt DateTime  @default(now()) // backoff target

  createdAt DateTime @default(now())

  @@index([status, availableAt])
  @@index([aggregate, aggregateId])
  @@map("outbox_events")
}

/// Request-level deduplication for money-moving endpoints. The stored response
/// is replayed verbatim so a retried request can never double-charge.
model IdempotencyRecord {
  key          String    @id
  userId       String?   @db.Uuid
  endpoint     String
  requestHash  String // rejects key reuse with a different body
  statusCode   Int?
  responseBody Json?
  lockedAt     DateTime? // in-flight marker
  completedAt  DateTime?
  expiresAt    DateTime

  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
  @@map("idempotency_records")
}

/// Inbound provider/gateway callbacks. Stored before processing so a replayed
/// webhook is detected rather than applied twice.
model InboundWebhook {
  id        String        @id @default(uuid()) @db.Uuid
  source    String // fazercards, foxreload, stripe ...
  eventId   String // provider's own event id
  eventType String
  signature String?
  headers   Json?
  payload   Json
  status    WebhookStatus @default(RECEIVED)
  error     String?

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([source, eventId])
  @@index([status, createdAt])
  @@map("inbound_webhooks")
}

/// Localised notification bodies, editable without a deploy.
model NotificationTemplate {
  key      String   @id // order.completed, payment.failed ...
  channels String[] // which channels this template supports
  titleAr  String
  titleEn  String
  bodyAr   String
  bodyEn   String
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}

// ═══════════════ REPORTING ROLLUPS ═══════════════

/// Pre-aggregated daily figures.
///
/// Dashboards read this instead of scanning orders ⨝ order_items. Recomputed
/// nightly for the previous few days, and re-computable for any single historic
/// day after a correction — which a materialised view cannot do without a full

/// Account values a customer saved for a game (player ID, username…), filled in next time.
model SavedInput {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String   @db.Uuid
  label     String?
  /// { "<input key>": "<value>" }
  values    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, gameId])
  @@map("saved_inputs")
}

/// A brand the customer marked with a heart (brand key as the store groups products).
model Favorite {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandKey  String
  createdAt DateTime @default(now())

  @@id([userId, brandKey])
  @@map("favorites")
}

/// "Tell me when the price drops" (kind price) or "when it is back" (kind stock).
model PriceWatch {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String    @db.Uuid
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind         String    @default("price")
  /// The base (USD) price when the customer asked; a drop below it notifies them.
  priceAtWatch Decimal   @db.Decimal(14, 4)
  notifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([userId, productId, kind])
  @@index([productId, notifiedAt])
  @@map("price_watches")
}

/// A customer's rating of a delivered item; one per item.
model Review {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String    @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItemId String    @unique @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?
  isPublished Boolean   @default(true)
  reply       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([productId, isPublished])
  @@map("reviews")
}

/// "Problem with my order": a customer request and the shop's reply.
model SupportTicket {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?   @db.Uuid
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subject   String
  message   String
  /// OPEN | ANSWERED | CLOSED
  status    String    @default("OPEN")
  reply     String?
  repliedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@map("support_tickets")
}

/// What the shop learns from its visitors, for the owner's "opportunities" and
/// "errors" pages: searches that found nothing, brand pages viewed, product
/// suggestions, and errors in the browser or the server. Kept 90 days.
model StoreEvent {
  id        String   @id @default(uuid()) @db.Uuid
  /// search_miss | brand_view | suggestion | client_error | server_error
  kind      String   @db.VarChar(20)
  value     String   @db.VarChar(300)
  detail    Json?
  path      String?  @db.VarChar(200)
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@map("store_events")
}

// ═══════════════ PLATFORM V2 ═══════════════

// ─── Accounts ───

/// A WebAuthn credential: sign in with the phone's fingerprint or face. Only the public key is stored.
model Passkey {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique // base64url
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceName   String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("passkeys")
}

/// A WebAuthn challenge, valid for a few minutes and used once.
model WebAuthnChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  purpose   String // register | login
  challenge String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("webauthn_challenges")
}

enum RecoveryStatus {
  PENDING
  VERIFIED
  REJECTED
  COMPLETED
}

/// A customer who lost access asks support for help. Staff check ownership and open a
/// reset sent to a contact the customer controls; staff never see or set the password.
model AccountRecoveryRequest {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String?        @db.Uuid
  user         User?          @relation("RecoveryRequester", fields: [userId], references: [id], onDelete: SetNull)
  contact      String // the phone or email the customer typed
  fullName     String
  /// What the customer offers as proof (last order number, amount, date…).
  proof        String
  /// Where the reset goes once verified (a number or email the customer controls now).
  newContact   String?
  status       RecoveryStatus @default(PENDING)
  reviewedById String?        @db.Uuid
  reviewedBy   User?          @relation("RecoveryReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?
  reviewedAt   DateTime?
  completedAt  DateTime?
  ipAddress    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@map("account_recovery_requests")
}

// ─── USDT ───

enum UsdtNetwork {
  TRC20
  BEP20
  ERC20
}

enum UsdtDelivery {
  /// on-chain to a wallet address on the chosen network
  ONCHAIN
  /// internal Binance transfer to a Binance ID (UID), email or phone
  BINANCE
}

enum UsdtOrderStatus {
  NEW
  AWAITING_PAYMENT
  UNDER_REVIEW
  READY_TO_SEND
  COMPLETED
  REJECTED
  CANCELLED
}

/// A customer buying USDT. Nothing is ever sent automatically: staff check the payment,
/// the address and the network, send by hand and record the TXID.
model UsdtOrder {
  id             String          @id @default(uuid()) @db.Uuid
  number         String          @unique // USDT-20261020-000123
  userId         String          @db.Uuid
  user           User            @relation("UsdtOrderCustomer", fields: [userId], references: [id], onDelete: Restrict)
  status         UsdtOrderStatus @default(NEW)
  amountUsdt     Decimal         @db.Decimal(18, 6)
  delivery       UsdtDelivery
  network        UsdtNetwork?
  address        String?
  binanceId      String?
  /// Price of one USDT in the paying currency, frozen when the order was made.
  rate           Decimal         @db.Decimal(18, 6)
  currency       String          @db.Char(3)
  subtotal       Decimal         @db.Decimal(18, 4)
  fee            Decimal         @db.Decimal(18, 4)
  total          Decimal         @db.Decimal(18, 4)
  paymentMethod  String?
  payerPhone     String?
  paymentRef     String?
  proofUploadId  String?         @db.Uuid
  txid           String?         @unique
  rejectReason   String?
  reviewedById   String?         @db.Uuid
  reviewedBy     User?           @relation("UsdtOrderReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  idempotencyKey String?         @unique
  expiresAt      DateTime?
  paidAt         DateTime?
  approvedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  events UsdtOrderEvent[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("usdt_orders")
}

/// Every change to a USDT order, who made it and from which state.
model UsdtOrderEvent {
  id          String           @id @default(uuid()) @db.Uuid
  usdtOrderId String           @db.Uuid
  usdtOrder   UsdtOrder        @relation(fields: [usdtOrderId], references: [id], onDelete: Cascade)
  actorId     String?          @db.Uuid
  action      String
  fromStatus  UsdtOrderStatus?
  toStatus    UsdtOrderStatus?
  note        String?
  data        Json?
  createdAt   DateTime         @default(now())

  @@index([usdtOrderId, createdAt])
  @@map("usdt_order_events")
}

// ─── Agents (المندوبون) ───

enum CommissionType {
  PERCENT
  FIXED
}

enum CommissionStatus {
  /// order paid, not yet completed
  PENDING
  /// order completed: owed to the agent
  EARNED
  PAID
  /// order cancelled or refunded
  VOID
}

model Agent {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @unique @db.Uuid
  user            User           @relation("AgentUser", fields: [userId], references: [id], onDelete: Cascade)
  code            String         @unique
  isActive        Boolean        @default(true)
  commissionType  CommissionType @default(PERCENT)
  /// Percent of the order's net base-currency total, or a fixed base-currency amount per order.
  commissionValue Decimal        @db.Decimal(14, 4)
  note            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  referrals   User[]        @relation("AgentReferrals")
  orders      Order[]
  commissions Commission[]
  payouts     AgentPayout[]

  @@map("agents")
}

/// One commission per order at most (orderId is unique), so it can never be counted twice.
model Commission {
  id                String           @id @default(uuid()) @db.Uuid
  agentId           String           @db.Uuid
  agent             Agent            @relation(fields: [agentId], references: [id], onDelete: Restrict)
  orderId           String           @unique @db.Uuid
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Net order value the commission was computed on (base currency).
  basis             Decimal          @db.Decimal(14, 4)
  amount            Decimal          @db.Decimal(14, 4)
  currency          String           @db.Char(3)
  /// The rule at the time: { type, value }.
  rule              Json
  status            CommissionStatus @default(PENDING)
  payoutId          String?          @db.Uuid
  payout            AgentPayout?     @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  voidReason        String?
  earnedAt          DateTime?
  paidAt            DateTime?
  voidedAt          DateTime?
  /// A PAID commission whose order was refunded afterwards: what the agent owes back
  /// (cumulative). The paid amount stays as it was paid; the clawback is shown beside it.
  clawbackAmount    Decimal?         @db.Decimal(14, 4)
  /// How much of the clawback later payouts already deducted.
  clawbackRecovered Decimal?         @db.Decimal(14, 4)
  clawbackReason    String?
  clawbackAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([agentId, status])
  @@map("commissions")
}

model AgentPayout {
  id               String       @id @default(uuid()) @db.Uuid
  agentId          String       @db.Uuid
  agent            Agent        @relation(fields: [agentId], references: [id], onDelete: Restrict)
  amount           Decimal      @db.Decimal(14, 4)
  currency         String       @db.Char(3)
  reference        String?
  note             String?
  paidById         String?      @db.Uuid
  /// Open clawbacks taken off this payout (amount = commissions paid − this).
  clawbackDeducted Decimal?     @db.Decimal(14, 4)
  createdAt        DateTime     @default(now())
  commissions      Commission[]

  @@index([agentId, createdAt])
  @@map("agent_payouts")
}

// ─── Staff notifications ───

enum StaffPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// The owner's inbox: new orders, pending payments, failures, refunds, support, errors, backups.
/// dedupeKey keeps one live notice per subject; reminders bump remindCount instead of adding rows.
model StaffNotification {
  id             String        @id @default(uuid()) @db.Uuid
  type           String
  priority       StaffPriority @default(NORMAL)
  title          String
  body           String
  link           String?
  data           Json?
  dedupeKey      String        @unique
  entityType     String?
  entityId       String?
  readAt         DateTime?
  readById       String?       @db.Uuid
  resolvedAt     DateTime?
  remindCount    Int           @default(0)
  lastRemindedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([resolvedAt, priority, createdAt])
  @@index([type, createdAt])
  @@map("staff_notifications")
}

/// Per staff member: which notification types they muted.
model StaffNotificationPref {
  userId String  @db.Uuid
  type   String
  muted  Boolean @default(true)

  @@id([userId, type])
  @@map("staff_notification_prefs")
}

// ─── Bank notifications (Android admin app) ───

enum BankNoticeStatus {
  NEW
  SUGGESTED
  CONFIRMED
  IGNORED
  DUPLICATE
}

/// A payment notification the owner's Android phone read from a chosen bank app.
/// Evidence for the owner to review, never proof of payment: nothing is approved from it.
model BankNotification {
  id                 String           @id @default(uuid()) @db.Uuid
  deviceId           String
  sourceApp          String
  title              String?
  text               String
  postedAt           DateTime
  receivedAt         DateTime         @default(now())
  amount             Decimal?         @db.Decimal(18, 4)
  currency           String?          @db.Char(3)
  reference          String?
  sender             String?
  /// 0–100: how sure the parser is about amount and reference.
  confidence         Int              @default(0)
  parser             String
  status             BankNoticeStatus @default(NEW)
  /// Same app, text and time from the phone: the same notification sent twice.
  fingerprint        String           @unique
  duplicateOfId      String?          @db.Uuid
  suggestedPaymentId String?          @db.Uuid
  matchedPaymentId   String?          @db.Uuid
  reviewedById       String?          @db.Uuid
  reviewedAt         DateTime?
  reviewNote         String?

  @@index([status, receivedAt])
  @@index([reference])
  @@map("bank_notifications")
}

// ─── Backups ───

enum BackupStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Every backup attempt and how it went.
model BackupRun {
  id            String       @id @default(uuid()) @db.Uuid
  /// download | scheduled_daily | scheduled_weekly | manual_drive
  trigger       String
  /// download | google_drive
  destination   String
  status        BackupStatus @default(RUNNING)
  encrypted     Boolean      @default(false)
  sizeBytes     Int?
  sha256        String?
  remoteId      String?
  counts        Json?
  error         String?
  triggeredById String?      @db.Uuid
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?

  @@index([startedAt])
  @@map("backup_runs")
}

// ═══════════════ MARKETS & INTELLIGENCE ═══════════════

// ─── Markets: each country has its own currency, languages, payment methods and product rules ───

enum MarketReviewStatus {
  /// found by research (an agent or staff), not yet seen by the owner
  PENDING_REVIEW
  APPROVED
  REJECTED
  DEFERRED
  /// approved AND linked to a usable receiving account the owner set up (payment methods only)
  ACTIVE
}

enum ProductAvailability {
  AVAILABLE
  UNAVAILABLE
  /// works only with an account from a given region (e.g. a US gift card)
  REGION_ACCOUNT_REQUIRED
  UNKNOWN
}

/// A country the shop serves or is studying. Disabled until the owner turns it on.
model MarketCountry {
  code             String    @id @db.Char(2) // ISO 3166-1 alpha-2
  nameAr           String
  nameFr           String
  nameEn           String
  /// the default paying currency, then any other accepted ones
  currency         String    @db.Char(3)
  currencies       String[]  @default([])
  languages        String[]  @default([])
  dialCode         String
  enabled          Boolean   @default(false)
  notes            String?
  /// when research last looked at this country (payment methods, rules)
  lastResearchedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  methods      MarketPaymentMethod[]
  productRules ProductMarketRule[]

  @@map("market_countries")
}

/// A payment method that exists in a country, as research found it. Never offered to customers by
/// itself: the owner approves it, sets up a receiving account in Payment methods, then links it.
model MarketPaymentMethod {
  id             String             @id @default(uuid()) @db.Uuid
  countryCode    String             @db.Char(2)
  country        MarketCountry      @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  /// stable key, e.g. orange-money-ml
  key            String
  name           String
  provider       String?
  /// mobile_money | bank | card | crypto | cash
  kind           String
  currency       String?            @db.Char(3)
  /// documented fees, as the source states them (text, not computed)
  fees           String?
  /// research caveats the owner must see (e.g. "page not fetched, seen in search results only")
  note           String?
  /// [{ url, title, publisher, accessedAt }]
  sources        Json               @default("[]")
  /// 0–100: how sure the research is that this method exists and works for receiving money
  confidence     Int                @default(0)
  status         MarketReviewStatus @default(PENDING_REVIEW)
  lastVerifiedAt DateTime
  verifiedBy     String
  /// the owner's manual account (payments.manual_accounts id) once linked
  accountId      String?
  decisionById   String?            @db.Uuid
  decisionAt     DateTime?
  decisionNote   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([countryCode, key])
  @@index([status])
  @@map("market_payment_methods")
}

/// Whether a product, brand or category works in a country.
model ProductMarketRule {
  id             String              @id @default(uuid()) @db.Uuid
  countryCode    String              @db.Char(2)
  country        MarketCountry       @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  /// product (sku) | brand (brand key) | category (slug)
  scope          String
  ref            String
  availability   ProductAvailability @default(UNKNOWN)
  note           String?
  sources        Json                @default("[]")
  confidence     Int                 @default(0)
  status         MarketReviewStatus  @default(PENDING_REVIEW)
  lastVerifiedAt DateTime
  verifiedBy     String
  decisionById   String?             @db.Uuid
  decisionAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([countryCode, scope, ref])
  @@index([status])
  @@map("product_market_rules")
}

// ─── Discovery engine ───

enum DiscoveryStatus {
  NEW
  PENDING_REVIEW
  APPROVED
  REJECTED
  DEFERRED
  IN_PROGRESS
  DONE
}

enum DiscoverySeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

/// Something an agent, a scanner or CI found: a bug, a risk, an unready product, an opportunity.
/// One row per subject (fingerprint): seeing it again bumps seenCount instead of adding a row.
model Discovery {
  id            String            @id @default(uuid()) @db.Uuid
  fingerprint   String            @unique
  /// bug | security | performance | ux | market | product | payment | data | opportunity | test
  kind          String
  title         String
  description   String
  /// [{ type: code|test|log|url|db|metric|ci, ref, detail }]
  evidence      Json              @default("[]")
  /// 0–100
  confidence    Int               @default(50)
  /// false = a hypothesis to check, true = reproduced / confirmed
  verified      Boolean           @default(false)
  severity      DiscoverySeverity @default(MEDIUM)
  impact        String
  proposal      String
  status        DiscoveryStatus   @default(NEW)
  /// who found it: discovery-engine, market-scout, qa-tester…
  source        String
  testResults   Json?
  branch        String?
  prUrl         String?
  seenCount     Int               @default(1)
  firstSeenAt   DateTime          @default(now())
  lastSeenAt    DateTime          @default(now())
  deferredUntil DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  decisions DiscoveryDecision[]

  @@index([status, severity])
  @@index([kind, status])
  @@map("discoveries")
}

/// The owner's (or staff's) decision log on discoveries.
model DiscoveryDecision {
  id          String    @id @default(uuid()) @db.Uuid
  discoveryId String    @db.Uuid
  discovery   Discovery @relation(fields: [discoveryId], references: [id], onDelete: Cascade)
  /// approve | reject | defer | reopen | start | done
  action      String
  note        String?
  actorId     String?   @db.Uuid
  actorLabel  String
  createdAt   DateTime  @default(now())

  @@index([discoveryId, createdAt])
  @@map("discovery_decisions")
}

/// One run of an agent, a scanner or the CI analysis.
model AgentRun {
  id          String    @id @default(uuid()) @db.Uuid
  agent       String
  /// manual | schedule | ci | app
  trigger     String
  /// RUNNING | SUCCEEDED | FAILED
  status      String
  summary     String?
  discoveries Int       @default(0)
  testsPassed Int?
  testsFailed Int?
  commit      String?
  branch      String?
  details     Json?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([agent, startedAt])
  @@map("agent_runs")
}
