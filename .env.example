# ─── Database ───
DATABASE_URL="postgresql://patron:patron@localhost:5432/patron?schema=public"
SHADOW_DATABASE_URL="postgresql://patron:patron@localhost:5432/patron_shadow?schema=public"

# ─── Crypto ───
# openssl rand -hex 32
ENCRYPTION_KEY=""

# ─── Backups (docs/DISASTER_RECOVERY.md) ───
# Key for scheduled backups to Google Drive (openssl rand -hex 32). Keep a copy
# OUTSIDE the server and the Drive: without it those copies cannot be opened.
BACKUP_ENCRYPTION_KEY=""
# Google Cloud OAuth client (Web application), scope drive.file only
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# https://<api host>/api/v1/admin/backup/gdrive/callback (also listed in the OAuth client)
GOOGLE_REDIRECT_URI=""
# Restore runner only, for a .patronbak downloaded with a passphrase
BACKUP_PASSPHRASE=""

# ─── Seed ───
SEED_ADMIN_EMAIL="admin@patron.sa"
SEED_ADMIN_PASSWORD=""

# ─── Providers ───
FAZERCARDS_BASE_URL="https://api.fazercards.com/v1"
FAZERCARDS_API_KEY=""
FOXRELOAD_BASE_URL="https://api.foxreload.com/v2"
FOXRELOAD_API_KEY=""

# ─── App ───
NODE_ENV="development"
PORT=3000
API_PREFIX="api/v1"
# Reverse proxies in front of the API (1 behind a load balancer such as Render's)
TRUST_PROXY_HOPS=0

# ─── JWT ───
JWT_ACCESS_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET=""
JWT_REFRESH_TTL="30d"

# ─── Currency ───
BASE_CURRENCY="USD"

# ─── Redis / queues ───
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ─── Payments ───
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── FX feed ───
FX_FEED_URL=""

# ─── Notifications ───
EMAIL_ENDPOINT=""
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@patron.io"
FCM_SERVER_KEY=""

# ─── Sign-in codes (accounts) ───
# Phone codes: owner_relay (default: the owner sends them by WhatsApp from the
# dashboard «رموز التحقق»), twilio_verify (automatic SMS/WhatsApp), capture (tests only)
OTP_PROVIDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
# sms (default) or whatsapp
TWILIO_VERIFY_CHANNEL=""
# Email codes (verification, reset, recovery) go out through Resend when a key is
# set; without one, email-code endpoints answer EMAIL_NOT_CONFIGURED.
# EMAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=""
# Fingerprint/face sign-in (passkeys): the store's address. WEBAUTHN_RP_ID
# defaults to its host name.
STOREFRONT_URL="http://localhost:3002"
WEBAUTHN_RP_ID=""

# ─── Intelligence (POST /admin/intelligence/ingest) ───
# Shared token for CI and the AI agents to post runs and discoveries (header
# x-intel-token). Empty = that route only accepts a staff session with
# intelligence.decide. At least 16 characters: openssl rand -hex 32
INTEL_INGEST_TOKEN=""

# ─── Observability ───
LOG_LEVEL="info"
METRICS_TOKEN=""

# ─── Tracing ───
OTEL_ENABLED="false"
OTEL_SERVICE_NAME="patron-api"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_SAMPLE_RATIO="0.1"
OTEL_DEBUG="false"
APP_VERSION="0.0.0"
