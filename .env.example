# ─── Database ───
DATABASE_URL="postgresql://patron:patron@localhost:5432/patron?schema=public"
SHADOW_DATABASE_URL="postgresql://patron:patron@localhost:5432/patron_shadow?schema=public"

# ─── Crypto ───
# openssl rand -hex 32
ENCRYPTION_KEY=""

# ─── Seed ───
SEED_ADMIN_EMAIL="admin@patron.sa"
SEED_ADMIN_PASSWORD=""

# ─── Providers ───
FAZERCARDS_BASE_URL="https://api.fazercards.com/v1"
FAZERCARDS_API_KEY=""
FOXRELOAD_BASE_URL="https://api.foxreload.com/v2"
FOXRELOAD_API_KEY=""

# ─── App ───
NODE_ENV="development"
PORT=3000
API_PREFIX="api/v1"

# ─── JWT ───
JWT_ACCESS_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET=""
JWT_REFRESH_TTL="30d"

# ─── Currency ───
BASE_CURRENCY="USD"

# ─── Redis / queues ───
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ─── Payments ───
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── FX feed ───
FX_FEED_URL=""

# ─── Notifications ───
EMAIL_ENDPOINT=""
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@patron.io"
FCM_SERVER_KEY=""

# ─── Observability ───
LOG_LEVEL="info"
METRICS_TOKEN=""

# ─── Tracing ───
OTEL_ENABLED="false"
OTEL_SERVICE_NAME="patron-api"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_SAMPLE_RATIO="0.1"
OTEL_DEBUG="false"
APP_VERSION="0.0.0"
