// ═══════════════════════════════════════════════════════════════
//  Patron Platform — Database Schema  (v1.0 FINAL)
//  PostgreSQL 15+ / Prisma 6
//  Conventions:
//    - UUID primary keys
//    - Money = Decimal(14,4); minor-unit safe, no floats
//    - Soft delete via deletedAt on customer-visible entities
//    - *Enc suffix = encrypted at rest (AES-256-GCM, app layer)
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════ ENUMS ═══════════════

enum ProductType {
  GAME_TOPUP
  GIFT_CARD
  SUBSCRIPTION
  LICENSE
}

enum DeliveryMode {
  AUTO_PROVIDER // fulfilled live via external provider API
  CODE_POOL     // pulled from pre-purchased code inventory
  MANUAL        // admin fulfils by hand
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentGateway {
  WALLET
  MOYASAR
  TAP
  STRIPE
  MANUAL
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum WalletTxnType {
  TOPUP
  ORDER_PAYMENT
  REFUND
  ADMIN_ADJUSTMENT
  CASHBACK
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PHONE_VERIFY
  PASSWORD_RESET
  TWO_FACTOR
}

enum QuoteStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
  DEAD
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  FAILED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// ═══════════════ USERS & ACCESS CONTROL ═══════════════

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  phone         String?   @unique
  passwordHash  String
  fullName      String
  avatarUrl     String?
  locale        String    @default("ar")
  isActive      Boolean   @default(true)
  isBlocked     Boolean   @default(false)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  twoFaSecretEnc  String?
  twoFaEnabled    Boolean @default(false)
  defaultCurrency String  @default("USD") @db.Char(3)
  lastLoginAt     DateTime?
  lastLoginIp     String?

  roles              UserRole[]
  orders             Order[]
  quotes             CheckoutQuote[]
  payments           Payment[]
  wallets            Wallet[]
  walletTransactions WalletTransaction[]
  notifications      Notification[]
  devices            DeviceToken[]
  refreshTokens      RefreshToken[]
  verifications      VerificationToken[]
  auditLogs          AuditLog[]
  refundsRequested   Refund[]            @relation("RefundRequester")
  refundsProcessed   Refund[]            @relation("RefundProcessor")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique // super_admin, admin, support, finance, customer
  description String?
  isSystem    Boolean @default(false) // system roles cannot be deleted

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique // "orders.refund", "products.create"
  module      String // orders, products, providers, reports ...
  description String?

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Refresh-token rotation; one row per active session
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique // SHA-256 of the token, never the raw value
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid

  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// OTP / one-time links for verification, 2FA and password reset
model VerificationToken {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   VerificationPurpose
  codeHash  String
  expiresAt DateTime
  consumedAt DateTime?
  attempts  Int                 @default(0)

  createdAt DateTime @default(now())

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String // email or phone entered
  ipAddress  String
  success    Boolean
  reason     String?
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model DeviceToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String         @unique
  platform  DevicePlatform
  isActive  Boolean        @default(true)
  lastSeenAt DateTime      @default(now())

  createdAt DateTime @default(now())

  @@index([userId, isActive])
  @@map("device_tokens")
}

// ═══════════════ CATALOG ═══════════════

model Category {
  id        String  @id @default(uuid()) @db.Uuid
  slug      String  @unique
  nameAr    String
  nameEn    String
  iconUrl   String?
  bannerUrl String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  parentId String?    @db.Uuid
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  games    Game[]
  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

model Game {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  nameAr      String
  nameEn      String
  description String?
  coverUrl    String?
  logoUrl     String?
  publisher   String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  isFeatured  Boolean @default(false)

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Declarative form the customer fills before checkout.
  // [{ key, labelAr, labelEn, type, required, regex, sensitive }]
  inputSchema Json?

  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId, isActive])
  @@index([isFeatured])
  @@map("games")
}

model Product {
  id          String       @id @default(uuid()) @db.Uuid
  sku         String       @unique
  type        ProductType
  delivery    DeliveryMode
  nameAr      String
  nameEn      String
  description String?
  imageUrl    String?

  costPrice Decimal @db.Decimal(14, 4) // reference cost, actual cost per provider
  sellPrice Decimal @db.Decimal(14, 4)
  currency  String  @default("SAR") @db.Char(3)

  // null stockQty = unlimited (provider-backed); CODE_POOL derives from code inventory
  stockQty      Int?
  lowStockAlert Int?    @default(5)
  maxPerOrder   Int     @default(10)
  isActive      Boolean @default(true)
  isFeatured    Boolean @default(false)
  sortOrder     Int     @default(0)

  // type-specific extras: { durationDays, region, platform, licenseTerm ... }
  metadata Json?

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  gameId     String?  @db.Uuid
  game       Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)

  prices     ProductPrice[]
  quoteItems QuoteItem[]
  providers  ProductProvider[]
  codes      ProductCode[]
  orderItems OrderItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId, isActive])
  @@index([gameId, isActive])
  @@index([type, isActive])
  @@index([isFeatured])
  @@map("products")
}

// Pre-purchased inventory for CODE_POOL products
model ProductCode {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  codeEnc   String // AES-256-GCM ciphertext
  serialEnc String?
  batchRef  String?
  expiresAt DateTime?

  isUsed      Boolean    @default(false)
  usedAt      DateTime?
  orderItemId String?    @unique @db.Uuid
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId, isUsed])
  @@index([expiresAt])
  @@map("product_codes")
}

model Banner {
  id        String    @id @default(uuid()) @db.Uuid
  titleAr   String
  titleEn   String
  imageUrl  String
  linkType  String? // category | game | product | url
  linkValue String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("banners")
}

// ═══════════════ PROVIDERS ═══════════════

model Provider {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique // fazercards, foxreload
  name    String
  baseUrl String

  apiKeyEnc    String // encrypted
  apiSecretEnc String?
  extraConfig  Json? // per-provider knobs (currency, callback url, ...)

  isActive       Boolean @default(true)
  priority       Int     @default(0) // lower = tried first
  balance        Decimal @default(0) @db.Decimal(14, 4)
  lowBalanceAlert Decimal? @db.Decimal(14, 4)
  timeoutMs      Int     @default(20000)
  maxRetries     Int     @default(2)

  lastHealthCheckAt DateTime?
  isHealthy         Boolean  @default(true)

  products ProductProvider[]
  calls    ProviderCall[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, priority])
  @@map("providers")
}

// Mapping table: which provider can fulfil which product, at what cost
model ProductProvider {
  id           String  @id @default(uuid()) @db.Uuid
  productId    String  @db.Uuid
  providerId   String  @db.Uuid
  providerSku  String // the provider's own product identifier
  providerCost Decimal @db.Decimal(14, 4)
  priority     Int     @default(0) // failover order within the product
  isActive     Boolean @default(true)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, providerId])
  @@unique([providerId, providerSku])
  @@index([productId, priority])
  @@map("product_providers")
}

// Full audit of every outbound provider request — billing disputes depend on this
model ProviderCall {
  id          String   @id @default(uuid()) @db.Uuid
  providerId  String   @db.Uuid
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  orderItemId String?    @db.Uuid
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  endpoint       String
  httpMethod     String   @default("POST")
  idempotencyKey String?  @unique
  requestBody    Json // secrets redacted before persisting
  responseBody   Json?
  httpStatus     Int?
  success        Boolean  @default(false)
  errorCode      String?
  errorMessage   String?
  attemptNo      Int      @default(1)
  durationMs     Int?

  createdAt DateTime @default(now())

  @@index([orderItemId])
  @@index([providerId, createdAt])
  @@index([success, createdAt])
  @@map("provider_calls")
}

// ═══════════════ ORDERS ═══════════════

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  orderNumber String      @unique // PTN-20260720-000123
  userId      String      @db.Uuid
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status      OrderStatus @default(PENDING_PAYMENT)

  subtotal Decimal @db.Decimal(14, 4)
  discount Decimal @default(0) @db.Decimal(14, 4)
  fees     Decimal @default(0) @db.Decimal(14, 4)
  // MVP: always 0. Wiring VAT on later is a config change, not a migration.
  taxAmount   Decimal  @default(0) @db.Decimal(14, 4)
  taxRate     Decimal? @db.Decimal(6, 4)
  taxInclusive Boolean @default(false)
  total    Decimal @db.Decimal(14, 4)

  // Currency the customer transacted in, plus the rate snapshot used to
  // express this order in the platform base currency for reporting.
  currency     String  @db.Char(3)
  baseCurrency String  @db.Char(3)
  fxRate       Decimal @db.Decimal(20, 10)
  totalBase    Decimal @db.Decimal(14, 4)
  fxRateId     String? @db.Uuid
  fxRateUsed   FxRate? @relation(fields: [fxRateId], references: [id], onDelete: SetNull)

  couponId String? @db.Uuid
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  quoteId        String? @unique @db.Uuid
  quote          CheckoutQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  // Incremented on every write; concurrent updates lose and retry.
  version        Int     @default(0)
  idempotencyKey String? @unique // guards double-submit from mobile clients
  ipAddress      String?
  userAgent      String?
  notes          String?

  items    OrderItem[]
  payments Payment[]
  refunds  Refund[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  completedAt DateTime?

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // price/name snapshot — catalog changes must never rewrite history
  productNameAr String
  productNameEn String
  quantity      Int             @default(1)
  unitPrice     Decimal         @db.Decimal(14, 4)
  unitCost      Decimal         @db.Decimal(14, 4)
  lineTotal     Decimal         @db.Decimal(14, 4)
  taxAmount     Decimal         @default(0) @db.Decimal(14, 4)
  taxRate       Decimal?        @db.Decimal(6, 4)
  status        OrderItemStatus @default(PENDING)

  // Provider chosen when the quote was priced. The engine may fail over to a
  // different one, but the cost we committed to is the frozen unitCost.
  plannedProviderId     String? @db.Uuid
  fulfilledByProviderId String? @db.Uuid
  attemptCount          Int     @default(0)
  lastError             String?
  version               Int     @default(0)

  inputs        OrderInput[]
  results       OrderResult[]
  providerCalls ProviderCall[]
  assignedCode  ProductCode?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deliveredAt DateTime?

  @@index([orderId])
  @@index([status])
  @@index([productId])
  @@map("order_items")
}

// What the customer typed at checkout (Player ID, server, email ...)
model OrderInput {
  id          String    @id @default(uuid()) @db.Uuid
  orderItemId String    @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  fieldKey    String
  fieldLabel  String
  value       String // encrypted when isSensitive
  isSensitive Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([orderItemId, fieldKey])
  @@map("order_inputs")
}

// What was actually delivered (code, serial, receipt, provider message)
model OrderResult {
  id          String    @id @default(uuid()) @db.Uuid
  orderItemId String    @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  resultType  String // code | serial | receipt | message
  valueEnc    String // AES-256-GCM ciphertext
  providerRef String?
  viewedAt    DateTime? // first time the customer revealed it
  deliveredAt DateTime  @default(now())

  @@index([orderItemId])
  @@map("order_results")
}

// ═══════════════ PAYMENTS ═══════════════

model Payment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  userId  String @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  gateway        PaymentGateway
  gatewayRef     String?        @unique
  amount         Decimal        @db.Decimal(14, 4)
  currency       String         @db.Char(3)
  baseCurrency   String         @db.Char(3)
  fxRate         Decimal        @db.Decimal(20, 10)
  amountBase     Decimal        @db.Decimal(14, 4)
  fxRateId       String?        @db.Uuid
  fxRateUsed     FxRate?        @relation(fields: [fxRateId], references: [id], onDelete: SetNull)
  status         PaymentStatus  @default(INITIATED)
  refundedAmount Decimal        @default(0) @db.Decimal(14, 4)

  version   Int     @default(0)
  cardBrand String?
  cardLast4 String? @db.VarChar(4)

  rawResponse  Json? // PAN/CVV never stored
  failureCode  String?
  failureReason String?

  refunds Refund[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  capturedAt DateTime?

  @@index([orderId])
  @@index([userId, status])
  @@index([status, createdAt])
  @@map("payments")
}

model Refund {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId String? @db.Uuid
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  amount     Decimal      @db.Decimal(14, 4)
  currency   String       @db.Char(3)
  fxRate     Decimal      @db.Decimal(20, 10)
  amountBase Decimal      @db.Decimal(14, 4)
  reason     String
  status     RefundStatus @default(REQUESTED)
  gatewayRef String?
  toWallet   Boolean      @default(false)

  requestedById String @db.Uuid
  requestedBy   User   @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  processedById String? @db.Uuid
  processedBy   User?  @relation("RefundProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  @@index([orderId])
  @@index([status, createdAt])
  @@map("refunds")
}

model WalletTransaction {
  id       String        @id @default(uuid()) @db.Uuid
  walletId String        @db.Uuid
  wallet   Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId   String        @db.Uuid
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     WalletTxnType

  amount        Decimal @db.Decimal(14, 4) // signed: credit +, debit −
  balanceBefore Decimal @db.Decimal(14, 4)
  balanceAfter  Decimal @db.Decimal(14, 4)
  currency      String  @db.Char(3)

  referenceType String? // order | payment | refund | manual
  referenceId   String? @db.Uuid
  description   String?
  createdById   String? @db.Uuid // admin who made the adjustment

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

model Coupon {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(14, 4)
  maxDiscount   Decimal?     @db.Decimal(14, 4) // caps a PERCENT coupon
  minOrderTotal Decimal?     @db.Decimal(14, 4)
  // FIXED coupons and thresholds are denominated in this currency and
  // converted at redemption. null = platform base currency.
  currency      String?      @db.Char(3)

  maxUses        Int?
  maxUsesPerUser Int?      @default(1)
  usedCount      Int       @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)

  orders Order[]
  quotes CheckoutQuote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, expiresAt])
  @@map("coupons")
}

// ═══════════════ SYSTEM ═══════════════

model Notification {
  id      String              @id @default(uuid()) @db.Uuid
  userId  String              @db.Uuid
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel NotificationChannel @default(IN_APP)

  titleAr String
  titleEn String
  bodyAr  String
  bodyEn  String
  data    Json? // deep-link payload: { type, orderId ... }

  isRead Boolean   @default(false)
  readAt DateTime?
  sentAt DateTime?
  error  String?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String // order.refund, product.update, provider.key_rotate
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Pre-aggregated daily figures. The raw tables remain the source of truth;
/// this is a cache that can be rebuilt from them at any time.
model DailyRollup {
  day            DateTime @db.Date
  currency       String   @db.Char(3)
  orders         Int      @default(0)
  paidOrders     Int      @default(0)
  failedOrders   Int      @default(0)
  itemsDelivered Int      @default(0)
  itemsFailed    Int      @default(0)
  grossBase      Decimal  @default(0) @db.Decimal(18, 4)
  discountBase   Decimal  @default(0) @db.Decimal(18, 4)
  refundBase     Decimal  @default(0) @db.Decimal(18, 4)
  costBase       Decimal  @default(0) @db.Decimal(18, 4)
  newCustomers   Int      @default(0)
  computedAt     DateTime @default(now())

  @@id([day, currency])
  @@index([day])
  @@map("daily_rollups")
}

model SystemSetting {
  key         String   @id
  value       Json
  group       String   @default("general")
  description String?
  isPublic    Boolean  @default(false) // exposed to the customer apps

  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("system_settings")
}


// ═══════════════ CURRENCY & FX ═══════════════

model Currency {
  code     String  @id @db.Char(3) // USD, EUR, MRU, XOF
  nameAr   String
  nameEn   String
  symbol   String
  decimals Int     @default(2) // XOF = 0, MRU = 2, USD/EUR = 2
  isBase   Boolean @default(false) // exactly one row may be true
  isActive Boolean @default(true)
  sortOrder Int    @default(0)

  // rounding applied after conversion: HALF_UP | UP | DOWN
  roundingMode String @default("HALF_UP")
  // optional psychological rounding, e.g. 100 => nearest 100 XOF
  roundingStep Decimal? @db.Decimal(14, 4)

  ratesFrom     FxRate[]        @relation("FxBase")
  ratesTo       FxRate[]        @relation("FxQuote")
  productPrices ProductPrice[]
  wallets       Wallet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("currencies")
}

// Immutable, append-only rate history. Never updated in place — a new rate
// supersedes the previous one, so every historic order can be re-derived.
model FxRate {
  id            String @id @default(uuid()) @db.Uuid
  baseCurrency  String @db.Char(3)
  quoteCurrency String @db.Char(3)
  rate          Decimal @db.Decimal(20, 10) // 1 base = <rate> quote

  source      String    @default("MANUAL") // MANUAL | ECB | OPENEXCHANGE ...
  effectiveAt DateTime  @default(now())
  expiresAt   DateTime?
  isActive    Boolean   @default(true)

  base  Currency @relation("FxBase", fields: [baseCurrency], references: [code], onDelete: Restrict)
  quote Currency @relation("FxQuote", fields: [quoteCurrency], references: [code], onDelete: Restrict)

  orders   Order[]
  payments Payment[]
  quotes   CheckoutQuote[]

  createdById String? @db.Uuid
  createdAt   DateTime @default(now())

  @@unique([baseCurrency, quoteCurrency, effectiveAt])
  @@index([baseCurrency, quoteCurrency, isActive, effectiveAt])
  @@map("fx_rates")
}

// Optional manual price override per currency. When absent, the product's
// base-currency sellPrice is converted with the live FxRate.
model ProductPrice {
  id           String  @id @default(uuid()) @db.Uuid
  productId    String  @db.Uuid
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  currencyCode String  @db.Char(3)
  currency     Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  sellPrice Decimal @db.Decimal(14, 4)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, currencyCode])
  @@index([currencyCode])
  @@map("product_prices")
}

// One balance per user per currency. Balances are never converted between
// wallets implicitly — a top-up in EUR stays in EUR.
model Wallet {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currencyCode String   @db.Char(3)
  currency     Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  balance  Decimal @default(0) @db.Decimal(14, 4)
  version  Int     @default(0)
  isActive Boolean @default(true)

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, currencyCode])
  @@index([userId])
  @@map("wallets")
}


// ═══════════════ CHECKOUT QUOTES ═══════════════

/// A priced, time-boxed offer. Everything that can move between browsing and
/// paying — sell price, provider cost, FX rate, tax — is frozen here, so the
/// customer pays exactly what they were shown and margin is known up front.
model CheckoutQuote {
  id          String      @id @default(uuid()) @db.Uuid
  quoteNumber String      @unique
  userId      String      @db.Uuid
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      QuoteStatus @default(ACTIVE)

  // ── frozen money ──
  subtotal     Decimal @db.Decimal(14, 4)
  discount     Decimal @default(0) @db.Decimal(14, 4)
  fees         Decimal @default(0) @db.Decimal(14, 4)
  taxAmount    Decimal @default(0) @db.Decimal(14, 4)
  taxRate      Decimal? @db.Decimal(6, 4)
  taxInclusive Boolean @default(false)
  total        Decimal @db.Decimal(14, 4)

  // ── frozen FX ──
  currency     String  @db.Char(3)
  baseCurrency String  @db.Char(3)
  fxRate       Decimal @db.Decimal(20, 10)
  fxRateId     String? @db.Uuid
  fxRateUsed   FxRate? @relation(fields: [fxRateId], references: [id], onDelete: SetNull)
  totalBase    Decimal @db.Decimal(14, 4)

  // ── frozen cost, for margin at the moment of sale ──
  totalCostBase Decimal @db.Decimal(14, 4)

  couponId String? @db.Uuid
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  expiresAt  DateTime
  consumedAt DateTime?
  ipAddress  String?

  items QuoteItem[]
  order Order?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("checkout_quotes")
}

model QuoteItem {
  id        String        @id @default(uuid()) @db.Uuid
  quoteId   String        @db.Uuid
  quote     CheckoutQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String        @db.Uuid
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  // snapshots — the catalog may change before the quote is consumed
  productNameAr String
  productNameEn String
  quantity      Int     @default(1)
  unitPrice     Decimal @db.Decimal(14, 4) // in quote currency
  unitPriceBase Decimal @db.Decimal(14, 4)
  unitCostBase  Decimal @db.Decimal(14, 4) // provider cost at quote time
  lineTotal     Decimal @db.Decimal(14, 4)
  taxAmount     Decimal @default(0) @db.Decimal(14, 4)

  plannedProviderId String? @db.Uuid

  inputs QuoteItemInput[]

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@map("quote_items")
}

model QuoteItemInput {
  id          String    @id @default(uuid()) @db.Uuid
  quoteItemId String    @db.Uuid
  quoteItem   QuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)

  fieldKey    String
  fieldLabel  String
  value       String
  isSensitive Boolean @default(false)

  @@unique([quoteItemId, fieldKey])
  @@map("quote_item_inputs")
}

// ═══════════════ RELIABILITY PRIMITIVES ═══════════════

/// Transactional outbox. Side effects (queue jobs, notifications) are written
/// in the same transaction as the state change, then published by a relay.
/// Guarantees a committed order can never lose its fulfilment job.
model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  aggregate   String // Order, Payment, Refund ...
  aggregateId String
  eventType   String // order.paid, payment.captured ...
  payload     Json
  status      OutboxStatus @default(PENDING)

  attempts    Int       @default(0)
  lastError   String?
  publishedAt DateTime?
  availableAt DateTime  @default(now()) // backoff target

  createdAt DateTime @default(now())

  @@index([status, availableAt])
  @@index([aggregate, aggregateId])
  @@map("outbox_events")
}

/// Request-level deduplication for money-moving endpoints. The stored response
/// is replayed verbatim so a retried request can never double-charge.
model IdempotencyRecord {
  key          String    @id
  userId       String?   @db.Uuid
  endpoint     String
  requestHash  String // rejects key reuse with a different body
  statusCode   Int?
  responseBody Json?
  lockedAt     DateTime? // in-flight marker
  completedAt  DateTime?
  expiresAt    DateTime

  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
  @@map("idempotency_records")
}

/// Inbound provider/gateway callbacks. Stored before processing so a replayed
/// webhook is detected rather than applied twice.
model InboundWebhook {
  id         String        @id @default(uuid()) @db.Uuid
  source     String // fazercards, foxreload, stripe ...
  eventId    String // provider's own event id
  eventType  String
  signature  String?
  headers    Json?
  payload    Json
  status     WebhookStatus @default(RECEIVED)
  error      String?

  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([source, eventId])
  @@index([status, createdAt])
  @@map("inbound_webhooks")
}

/// Localised notification bodies, editable without a deploy.
model NotificationTemplate {
  key      String  @id // order.completed, payment.failed ...
  channels String[] // which channels this template supports
  titleAr  String
  titleEn  String
  bodyAr   String
  bodyEn   String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}


